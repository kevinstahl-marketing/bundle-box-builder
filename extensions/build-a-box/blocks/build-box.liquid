{% render 'vite-tag', entry: 'theme.jsx' %}

{% assign builder_metafield = product.metafields["$app"].build_a_box_builder %}
{% assign builder = builder_metafield.value %}

{% if builder == blank %}
  {% assign builder_id = block.settings.builder_id | strip %}

  {% if builder_id != blank %}
    {% assign builder_handle = 'builder-' | append: builder_id %}
    {% assign builder = metaobjects["$app:build_a_box_builder"][builder_handle] %}
  {% endif %}
{% else %}
  {% assign builder_id = builder.builder_id.value %}
  {% assign builder_handle = builder.system.handle %}
{% endif %}

{% if builder == blank %}

  <div class="build-a-box-root">
    <p>No Build a Box builder is attached.</p>

    {% if block.settings.builder_id == blank %}
      <small>
        Attach a builder to this product or enter a Builder ID in the block settings.
      </small>
    {% else %}
      <small>Builder handle: {{ builder_handle }}</small>
    {% endif %}
  </div>

{% else %}

  <div
    id="build-a-box-root-{{ block.id }}"
    class="build-a-box-root"
    data-build-a-box-root
    data-builder-id="{{ builder.builder_id.value | escape }}"
    data-builder-handle="{{ builder.system.handle | escape }}"
    data-show-title="{{ block.settings.show_title }}"
    data-show-images="{{ block.settings.show_images }}"
    data-button-label="{{ block.settings.button_label | escape }}"
  >
    <!-- React mounts here -->
  </div>

{% endif %}

{% schema %}
{
  "name": "Build a Box",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "builder_id",
      "label": "Fallback Builder ID",
      "info": "Optional. Used only when this product does not have a builder attached."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show builder title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show product images",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button label",
      "default": "Add box to cart"
    }
  ]
}
{% endschema %}